{
  "name": "overclock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "arena": "tsx apps/arena/src/main.ts",
    "engine": "tsx services/engine/src/main.ts",
    "dashboard": "pnpm --filter @overclock/dashboard dev",
    "cli": "tsx apps/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @overclock/dashboard typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:adversarial": "vitest run --project adversarial",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:all": "vitest run",
    "benchmark:sequential": "tsx packages/benchmarks/src/cli.ts --mode sequential",
    "benchmark:compiled": "tsx packages/benchmarks/src/cli.ts --mode compiled",
    "benchmark:parallel": "tsx packages/benchmarks/src/cli.ts --mode parallel",
    "benchmark:overclock": "tsx packages/benchmarks/src/cli.ts --mode overclock",
    "benchmark:all": "tsx packages/benchmarks/src/cli.ts --suite all",
    "benchmark:ablations": "tsx packages/benchmarks/src/cli.ts --suite ablations",
    "demo:reset": "tsx apps/cli/src/main.ts reset --seed 4242 --records 100",
    "benchmark:staged": "tsx packages/benchmarks/src/cli.ts --mode staged",
    "benchmark:report": "tsx packages/benchmarks/src/cli.ts --report",
    "test:network": "vitest run --config tests/network/vitest.config.ts",
    "test:network-capability": "vitest run --config tests/network-capability/vitest.config.ts",
    "network:dev": "tsx scripts/network-dev.ts",
    "network:generate": "tsx scripts/network-generate.ts",
    "network:test": "vitest run --config tests/network/vitest.config.ts",
    "network:deploy": "tsx scripts/network-deploy.ts",
    "network:probe": "tsx scripts/network-probe.ts",
    "network:authorize": "tsx scripts/network-authorize.ts",
    "network:demo": "tsx scripts/network-demo.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@overclock/contracts": "workspace:*",
    "@overclock/telemetry": "workspace:*",
    "@overclock/perception": "workspace:*",
    "@overclock/browser-runtime": "workspace:*",
    "@overclock/compiler": "workspace:*",
    "@overclock/optimizer": "workspace:*",
    "@overclock/scheduler": "workspace:*",
    "@overclock/verifier": "workspace:*",
    "@overclock/recovery": "workspace:*",
    "@overclock/models": "workspace:*",
    "@overclock/discovery": "workspace:*",
    "@overclock/swarm": "workspace:*",
    "@overclock/sdk": "workspace:*",
    "@overclock/benchmarks": "workspace:*",
    "@overclock/engine": "workspace:*",
    "@overclock/arena": "workspace:*",
    "playwright": "1.64.1",
    "zod": "4.6.7",
    "@overclock/network-contracts": "workspace:*",
    "@overclock/network-client": "workspace:*",
    "@overclock/network-capability": "workspace:*",
    "@overclock/external-baselines": "workspace:*"
  }
}
