# Claude (planner, scouts, repair, sequential baseline)
ANTHROPIC_API_KEY=
# TypeSafe Jev (reflex path: effect classification, recovery choices, modal/vision fallback)
TYPESAFE_API_KEY=

# Optional overrides
OVERCLOCK_PLANNER_MODEL=claude-opus-5-5
OVERCLOCK_PLANNER_EFFORT=low
# fast | standard. Fast mode (Claude API only) streams output faster at 2x the price; a refused
# fast request falls back to standard on its own.
OVERCLOCK_PLANNER_SPEED=fast
# The adversarial critique that gates writes
OVERCLOCK_CRITIC_MODEL=claude-opus-5-5
OVERCLOCK_CRITIC_SPEED=fast
OVERCLOCK_HELPER_MODEL=claude-haiku-5-5
OVERCLOCK_JEV_MODEL=jev-latest
OVERCLOCK_JEV_VISION_MODEL=jev-preview
# Browser processes for workers, whether each runs behind its own server process (1/0), and
# whether the engine launches them at startup (1) or on first use (0)
OVERCLOCK_BROWSERS=4
OVERCLOCK_BROWSER_SERVERS=1
OVERCLOCK_WARM_BROWSERS=1
# Chrome extension gateway (/api/x): accept only this extension id (optional), extra applications a
# new task may use (JSON list of {name, origin}), and the environment label shown in the side panel
OVERCLOCK_EXTENSION_ID=
OVERCLOCK_EXTENSION_APPS=
OVERCLOCK_ENVIRONMENT_LABEL=
OVERCLOCK_BENCH_BUDGET_USD=50
OVERCLOCK_ENGINE_PORT=4000
OVERCLOCK_ARENA_ADMIN_PORT=4100
OVERCLOCK_ARENA_CRM_PORT=4101
OVERCLOCK_ARENA_ORDERS_PORT=4102
OVERCLOCK_ARENA_SUPPORT_PORT=4103
OVERCLOCK_ARENA_APP4_PORT=4104
OVERCLOCK_HEADLESS=1

# Overclock Network (SpacetimeDB). Disabled by default; the engine runs fully offline without it.
OVERCLOCK_NETWORK_ENABLED=false
OVERCLOCK_NETWORK_ENDPOINT=ws://127.0.0.1:3100
OVERCLOCK_NETWORK_DATABASE=overclock-network
OVERCLOCK_NETWORK_MODE=network-read
OVERCLOCK_NETWORK_PUBLISH_ENABLED=false
OVERCLOCK_NETWORK_LOOKUP_TIMEOUT_MS=500
# Per-runtime state (engine DB, network token, artifact cache). Use a different dir per runtime.
OVERCLOCK_DATA_DIR=
OVERCLOCK_RUNTIME_LABEL=runtime-a
# Arena explorer (read-only) and operator accounts
ARENA_USERNAME=operator
ARENA_PASSWORD=overclock-arena
ARENA_VIEWER_USERNAME=viewer
ARENA_VIEWER_PASSWORD=overclock-viewer
